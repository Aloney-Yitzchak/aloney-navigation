<?xml version="1.0" encoding="utf-8"?>
<!-- T20a: photographing one building. Full-screen camera, the count on top, the shutter below. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    android:layoutDirection="rtl">

    <androidx.camera.view.PreviewView
        android:id="@+id/capture_preview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:implementationMode="compatible"
        app:scaleType="fitCenter" />

    <!-- a short white flash when a photo is taken -->
    <View
        android:id="@+id/capture_flash"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"
        android:background="@color/white"
        android:importantForAccessibility="no" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:layout_margin="@dimen/spacing_medium"
        android:background="@drawable/bg_rounded_dark"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="@dimen/spacing_small">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/capture_back"
            style="@style/Widget.Aloney.IconButton"
            android:layout_width="@dimen/touch_target"
            android:layout_height="@dimen/touch_target"
            android:contentDescription="@string/action_back"
            app:icon="@drawable/ic_arrow_back"
            app:iconTint="@color/white" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_small"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/capture_name"
                style="@style/Text.Body.Bold"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/white"
                tools:text="בניין המדעים" />

            <TextView
                android:id="@+id/capture_tip"
                style="@style/Text.Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/white"
                tools:text="עכשיו מזווית אחרת: כמה צעדים הצידה" />
        </LinearLayout>

        <TextView
            android:id="@+id/capture_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/spacing_small"
            android:background="@drawable/bg_pill_white"
            android:paddingHorizontal="12dp"
            android:paddingVertical="4dp"
            android:textColor="@color/primary_dark"
            android:textSize="@dimen/text_subtitle"
            android:textStyle="bold"
            tools:text="12/40" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="@dimen/spacing_large">

        <!-- the last photo, and a button to delete it if it came out blurred or with someone in it -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/capture_last"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="@drawable/bg_rounded_dark"
                android:contentDescription="@string/capture_last"
                android:scaleType="centerCrop"
                android:visibility="invisible" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/capture_delete_last"
                style="@style/Widget.Aloney.OverlayButton"
                android:layout_width="@dimen/touch_target"
                android:layout_height="@dimen/touch_target"
                android:layout_marginStart="@dimen/spacing_small"
                android:contentDescription="@string/capture_delete_last"
                android:visibility="invisible"
                app:icon="@drawable/ic_delete" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/capture_shutter"
            style="@style/Widget.Aloney.OverlayButton"
            android:layout_width="80dp"
            android:layout_height="80dp"
            app:backgroundTint="@color/white"
            android:contentDescription="@string/capture_shutter"
            app:icon="@drawable/ic_photo_camera"
            app:iconSize="36dp"
            app:iconTint="@color/primary"
            app:strokeColor="@color/primary_container"
            app:strokeWidth="4dp" />

        <Space
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />
    </LinearLayout>
</FrameLayout>
