<?xml version="1.0" encoding="utf-8"?>
<!-- Splash (docs/design/splash.png). The permissions view (view_permissions.xml) is the
     second state of the same screen: it is laid out from the start but stays invisible
     until the splash has been shown (finding 4). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/splash_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:layoutDirection="rtl">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/splash_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="@dimen/margin_screen">

        <com.google.android.material.chip.Chip
            android:id="@+id/splash_status"
            style="@style/Widget.Aloney.Chip.Green"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/splash_status_ok"
            app:chipIcon="@drawable/bg_dot_primary"
            app:chipIconSize="10dp"
            app:chipIconTint="@null"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <com.google.android.material.chip.Chip
            android:id="@+id/splash_network"
            style="@style/Widget.Aloney.Chip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/splash_status_network"
            app:chipIcon="@drawable/ic_wifi"
            app:chipIconTint="@color/text_secondary"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <FrameLayout
            android:id="@+id/splash_logo"
            android:layout_width="180dp"
            android:layout_height="180dp"
            android:background="@drawable/bg_circle_primary_container"
            app:layout_constraintBottom_toTopOf="@id/splash_title"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="packed">

            <ImageView
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_logo_leaf"
                app:tint="@color/primary" />

            <ImageView
                android:layout_width="@dimen/icon_circle"
                android:layout_height="@dimen/icon_circle"
                android:layout_gravity="bottom|start"
                android:background="@drawable/bg_circle_white"
                android:importantForAccessibility="no"
                android:padding="12dp"
                android:src="@drawable/ic_explore"
                app:tint="@color/primary" />
        </FrameLayout>

        <TextView
            android:id="@+id/splash_title"
            style="@style/Text.Display"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_large"
            android:text="@string/app_name"
            app:layout_constraintBottom_toTopOf="@id/splash_subtitle"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/splash_logo" />

        <TextView
            android:id="@+id/splash_subtitle"
            style="@style/Text.Secondary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_small"
            android:text="@string/splash_subtitle"
            android:textSize="@dimen/text_body"
            app:layout_constraintBottom_toTopOf="@id/splash_progress"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/splash_title" />

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/splash_progress"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/spacing_large"
            android:layout_marginTop="@dimen/spacing_xlarge"
            android:indeterminate="true"
            app:indicatorColor="@color/primary"
            app:trackColor="@color/primary_container"
            app:trackCornerRadius="4dp"
            app:trackThickness="8dp"
            app:layout_constraintBottom_toTopOf="@id/splash_loading"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/splash_subtitle" />

        <TextView
            android:id="@+id/splash_loading"
            style="@style/Text.Secondary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_small"
            android:drawablePadding="@dimen/spacing_small"
            android:gravity="center_vertical"
            android:text="@string/splash_loading"
            app:drawableStartCompat="@drawable/ic_sync"
            app:drawableTint="@color/primary"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/splash_progress" />

        <TextView
            android:id="@+id/splash_green"
            style="@style/Text.Secondary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:drawablePadding="@dimen/spacing_small"
            android:gravity="center_vertical"
            android:text="@string/splash_green"
            app:drawableStartCompat="@drawable/ic_forest"
            app:drawableTint="@color/primary"
            app:layout_constraintBottom_toTopOf="@id/splash_version"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <TextView
            android:id="@+id/splash_version"
            style="@style/Text.Secondary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_tiny"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            tools:text="גרסה 1.0" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <include
        android:id="@+id/splash_permissions"
        layout="@layout/view_permissions"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="invisible"
        tools:visibility="invisible" />
</FrameLayout>
