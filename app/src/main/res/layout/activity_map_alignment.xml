<?xml version="1.0" encoding="utf-8"?>
<!-- Yearly map alignment (docs/design/map-alignment.png, T27). The staff member lays the new
     school plan over the map with anchor points. alignment_map becomes osmdroid in T29. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:layoutDirection="rtl"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:navigationContentDescription="@string/action_close"
        app:navigationIcon="@drawable/ic_close"
        app:navigationIconTint="@color/text_primary"
        app:titleTextColor="@color/primary"
        tools:subtitle="שלב 2 מתוך 3"
        tools:title="התאמת מפת תשפ״ז" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <FrameLayout
            android:id="@+id/alignment_map"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/map_placeholder" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|center_horizontal"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_pill_white"
            android:drawablePadding="@dimen/spacing_small"
            android:elevation="2dp"
            android:gravity="center_vertical"
            android:paddingHorizontal="12dp"
            android:paddingVertical="8dp"
            android:text="@string/alignment_hint"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_secondary"
            app:drawableStartCompat="@drawable/ic_touch_app"
            app:drawableTint="@color/accent" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end|top"
            android:layout_marginTop="64dp"
            android:layout_marginEnd="@dimen/margin_screen"
            android:orientation="vertical">

            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/alignment_compass"
                style="@style/Widget.Aloney.MapButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="@string/alignment_compass"
                app:srcCompat="@drawable/ic_explore" />

            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/alignment_layers"
                style="@style/Widget.Aloney.MapButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:contentDescription="@string/alignment_layers"
                app:srcCompat="@drawable/ic_layers" />

            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/alignment_zoom_in"
                style="@style/Widget.Aloney.MapButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:contentDescription="@string/alignment_zoom_in"
                app:srcCompat="@drawable/ic_add" />

            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/alignment_zoom_out"
                style="@style/Widget.Aloney.MapButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:contentDescription="@string/alignment_zoom_out"
                app:srcCompat="@drawable/ic_remove" />
        </LinearLayout>
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="-24dp"
        android:background="@drawable/bg_sheet"
        android:elevation="8dp"
        android:orientation="vertical"
        android:padding="@dimen/margin_screen">

        <!-- how see-through the plan is over the map -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_rounded_card"
            android:orientation="vertical"
            android:padding="@dimen/spacing_medium">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/Text.Label"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:drawablePadding="@dimen/spacing_small"
                    android:gravity="center_vertical|start"
                    android:labelFor="@id/alignment_opacity"
                    android:text="@string/alignment_opacity"
                    app:drawableStartCompat="@drawable/ic_opacity"
                    app:drawableTint="@color/primary" />

                <TextView
                    android:id="@+id/alignment_opacity_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_pill_green"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="2dp"
                    android:textColor="@color/primary_dark"
                    android:textSize="@dimen/text_secondary"
                    android:textStyle="bold"
                    tools:text="50%" />
            </LinearLayout>

            <com.google.android.material.slider.Slider
                android:id="@+id/alignment_opacity"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:stepSize="10"
                android:value="50"
                android:valueFrom="0"
                android:valueTo="100"
                app:labelBehavior="gone" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    style="@style/Text.Secondary"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/alignment_opacity_map" />

                <TextView
                    style="@style/Text.Secondary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/alignment_opacity_plan" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/alignment_add_anchor"
                style="@style/Widget.Aloney.Button.Outlined"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/alignment_add_anchor"
                app:icon="@drawable/ic_add_location" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/alignment_here"
                style="@style/Widget.Aloney.Button.Outlined"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:text="@string/alignment_here"
                app:icon="@drawable/ic_my_location" />
        </LinearLayout>

        <TextView
            style="@style/Text.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_rounded_card"
            android:drawablePadding="@dimen/spacing_small"
            android:gravity="center_vertical|start"
            android:padding="12dp"
            android:text="@string/alignment_next_note"
            app:drawableStartCompat="@drawable/ic_info"
            app:drawableTint="@color/primary" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/alignment_save"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_medium"
            app:icon="@drawable/ic_arrow_forward"
            app:iconGravity="textEnd"
            tools:text="שמירה והמשך לשלב 3" />
    </LinearLayout>
</LinearLayout>
