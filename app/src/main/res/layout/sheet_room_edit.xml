<?xml version="1.0" encoding="utf-8"?>
<!-- Edit one room (docs/design/admin.png), a BottomSheetDialog over admin_rooms_state (T25).
     Only the fields the data model has: name and owner (finding 12). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_sheet"
    android:layoutDirection="rtl"
    android:orientation="vertical"
    android:paddingHorizontal="@dimen/margin_screen"
    android:paddingBottom="@dimen/spacing_small">

    <View
        android:layout_width="32dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginVertical="12dp"
        android:background="@drawable/bg_drag_handle" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/room_edit_number"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@drawable/bg_circle_primary_container"
            android:gravity="center"
            android:maxLines="1"
            android:textColor="@color/primary"
            android:textSize="@dimen/text_title"
            android:textStyle="bold"
            app:autoSizeMaxTextSize="@dimen/text_title"
            app:autoSizeMinTextSize="12sp"
            app:autoSizeTextType="uniform"
            tools:text="42" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/room_edit_title"
                style="@style/Text.Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                tools:text="עריכת חדר 42" />

            <TextView
                android:id="@+id/room_edit_entrance"
                style="@style/Text.Secondary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_tiny"
                android:background="@drawable/bg_pill_grey"
                android:drawablePadding="@dimen/spacing_tiny"
                android:gravity="center_vertical"
                android:paddingHorizontal="10dp"
                android:paddingVertical="2dp"
                app:drawableStartCompat="@drawable/ic_location_on"
                app:drawableTint="@color/text_secondary"
                tools:text="כניסה 12" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/room_edit_close"
            style="@style/Widget.Aloney.IconButton"
            android:layout_width="@dimen/touch_target"
            android:layout_height="@dimen/touch_target"
            android:contentDescription="@string/action_close"
            app:icon="@drawable/ic_close" />
    </LinearLayout>

    <TextView
        style="@style/Text.Secondary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_large"
        android:labelFor="@id/room_edit_name"
        android:text="@string/room_edit_name"
        android:textSize="@dimen/text_body" />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/room_edit_name_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_small"
        app:helperText="@string/room_edit_name_help"
        app:hintEnabled="false"
        app:startIconDrawable="@drawable/ic_meeting_room"
        app:startIconTint="@color/primary">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/room_edit_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="start|center_vertical"
            android:inputType="textCapSentences"
            android:paddingVertical="16dp" />
    </com.google.android.material.textfield.TextInputLayout>

    <TextView
        style="@style/Text.Secondary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_medium"
        android:labelFor="@id/room_edit_owner"
        android:text="@string/room_edit_owner"
        android:textSize="@dimen/text_body" />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/room_edit_owner_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_small"
        app:hintEnabled="false"
        app:startIconDrawable="@drawable/ic_person"
        app:startIconTint="@color/primary">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/room_edit_owner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="start|center_vertical"
            android:inputType="textPersonName"
            android:paddingVertical="16dp" />
    </com.google.android.material.textfield.TextInputLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_large"
        android:background="@drawable/bg_rounded_green"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp">

        <ImageView
            android:layout_width="@dimen/icon_medium"
            android:layout_height="@dimen/icon_medium"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_sync"
            app:tint="@color/primary" />

        <TextView
            style="@style/Text.Secondary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:text="@string/room_edit_sync_note"
            android:textColor="@color/primary_dark" />
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/room_edit_save"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_medium"
        android:text="@string/room_edit_save"
        app:icon="@drawable/ic_save" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/room_edit_cancel"
        style="@style/Widget.Aloney.Button.Text.Grey"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="@dimen/spacing_tiny"
        android:text="@string/action_cancel" />
</LinearLayout>
