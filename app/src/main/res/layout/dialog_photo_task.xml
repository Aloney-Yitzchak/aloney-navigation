<?xml version="1.0" encoding="utf-8"?>
<!-- T20a: add or edit a building to photograph. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layoutDirection="rtl"
    android:orientation="vertical"
    android:paddingHorizontal="24dp"
    android:paddingTop="@dimen/spacing_small">

    <TextView
        style="@style/Text.Label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:labelFor="@id/photo_task_name_field"
        android:text="@string/photo_task_name" />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/photo_task_name_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_tiny"
        app:hintEnabled="false"
        app:startIconDrawable="@drawable/ic_building">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/photo_task_name_field"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="start|center_vertical"
            android:hint="@string/photo_task_name_hint"
            android:inputType="textCapSentences" />
    </com.google.android.material.textfield.TextInputLayout>

    <TextView
        style="@style/Text.Label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_medium"
        android:labelFor="@id/photo_task_target_field"
        android:text="@string/photo_task_target" />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/photo_task_target_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_tiny"
        app:helperText="@string/photo_task_target_help"
        app:hintEnabled="false"
        app:startIconDrawable="@drawable/ic_photo_library">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/photo_task_target_field"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="start|center_vertical"
            android:inputType="number"
            android:maxLength="3" />
    </com.google.android.material.textfield.TextInputLayout>

    <TextView
        style="@style/Text.Label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_medium"
        android:labelFor="@id/photo_task_note_field"
        android:text="@string/photo_task_note" />

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_tiny"
        app:hintEnabled="false"
        app:startIconDrawable="@drawable/ic_notes">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/photo_task_note_field"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="start|center_vertical"
            android:hint="@string/photo_task_note_hint"
            android:inputType="textCapSentences|textMultiLine"
            android:maxLines="3" />
    </com.google.android.material.textfield.TextInputLayout>
</LinearLayout>
