<?xml version="1.0" encoding="utf-8"?>
<!-- Map and route (docs/design/map.png). The map itself comes in T29 (osmdroid);
     until then map_container is an empty green area. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:layoutDirection="rtl"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        style="@style/Widget.Aloney.Toolbar.Main"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:subtitle="@string/map_screen"
        app:title="@string/app_name" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <FrameLayout
            android:id="@+id/map_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/map_placeholder">

            <TextView
                android:id="@+id/map_placeholder"
                style="@style/Text.Secondary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="160dp"
                android:text="@string/map_placeholder" />
        </FrameLayout>

        <!-- over the map, at the top: "wrong location?" (finding 3), floors, my location -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="@dimen/margin_screen">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/map_wrong_location"
                style="@style/Widget.Aloney.Button.Tonal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:backgroundTint="@color/white"
                android:elevation="2dp"
                android:text="@string/map_wrong_location"
                android:textColor="@color/text_primary"
                app:icon="@drawable/ic_edit_location"
                app:iconTint="@color/primary" />

            <Space
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/map_floors"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:checkedButton="@id/map_floor_1"
                app:selectionRequired="true"
                app:singleSelection="true">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/map_floor_1"
                    style="@style/Widget.Aloney.FloorButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="ק' 1" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/map_floor_2"
                    style="@style/Widget.Aloney.FloorButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="ק' 2" />
            </com.google.android.material.button.MaterialButtonToggleGroup>

            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/map_my_location"
                style="@style/Widget.Aloney.MapButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_small"
                android:contentDescription="@string/map_my_location"
                app:fabSize="mini"
                app:srcCompat="@drawable/ic_my_location" />
        </LinearLayout>

        <!-- the chosen destination -->
        <LinearLayout
            android:id="@+id/map_sheet"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:background="@drawable/bg_sheet"
            android:elevation="8dp"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/margin_screen"
            android:paddingBottom="@dimen/spacing_small">

            <View
                android:layout_width="32dp"
                android:layout_height="4dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginVertical="12dp"
                android:background="@drawable/bg_drag_handle" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:layout_marginEnd="@dimen/spacing_small"
                    android:background="@drawable/bg_dot_accent" />

                <TextView
                    android:id="@+id/map_destination_name"
                    style="@style/Text.Title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    tools:text="חדר 42 — מתמטיקה" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/map_favorite"
                    style="@style/Widget.Aloney.IconButton"
                    android:layout_width="@dimen/touch_target"
                    android:layout_height="@dimen/touch_target"
                    android:contentDescription="@string/action_favorite"
                    app:icon="@drawable/ic_star" />
            </LinearLayout>

            <TextView
                android:id="@+id/map_destination_detail"
                style="@style/Text.Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="18dp"
                android:textSize="@dimen/text_body"
                tools:text="רכזת שכבה ט'" />

            <com.google.android.material.chip.ChipGroup
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:chipSpacingHorizontal="@dimen/spacing_small">

                <com.google.android.material.chip.Chip
                    android:id="@+id/map_distance"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:chipIcon="@drawable/ic_straighten"
                    tools:text="120 מ'" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/map_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:chipIcon="@drawable/ic_schedule"
                    tools:text="כ-2 דק' הליכה" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/map_entrance"
                    style="@style/Widget.Aloney.Chip.Green"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:chipIcon="@drawable/ic_building"
                    tools:text="אגף צפוני" />
            </com.google.android.material.chip.ChipGroup>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/map_start_ar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_medium"
                android:text="@string/map_start_ar"
                app:icon="@drawable/ic_view_in_ar" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/map_route_details"
                style="@style/Widget.Aloney.Button.Text.Grey"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:text="@string/map_route_details" />
        </LinearLayout>
    </FrameLayout>

    <include layout="@layout/view_bottom_nav" />
</LinearLayout>
