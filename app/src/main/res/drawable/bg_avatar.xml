<?xml version="1.0" encoding="utf-8"?>
<!-- Green circle with a person: the account button in the app bar (the icon paths are white) -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:width="40dp" android:height="40dp">
        <shape android:shape="oval"><solid android:color="@color/primary" /></shape>
    </item>
    <item android:width="22dp" android:height="22dp" android:gravity="center"
        android:drawable="@drawable/ic_person" />
</layer-list>
